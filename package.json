{
	"packageManager": "bun@1.4.0",
	"name": "@forgeax/settings",
	"version": "0.1.0",
	"private": false,
	"license": "Apache-2.0",
	"type": "module",
	"description": "ForgeaX standalone settings application — unified settings overlay, sections registry, env/keys, extensions, and changelog.",
	"repository": {
		"type": "git",
		"url": "https://github.com/ForgeaX-Games/forgeax-studio.git",
		"directory": "packages/settings"
	},
	"homepage": "https://github.com/ForgeaX-Games/forgeax-studio/tree/main/packages/settings",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "bun test src",
		"lint": "bun run lint:types && bun run lint:biome",
		"lint:types": "tsc --noEmit -p tsconfig.json",
		"lint:biome": "biome check --config-path=biome.json . --diagnostic-level=error",
		"lint:fix": "biome check --config-path=biome.json --write .",
		"lint:staged": "lint-staged",
		"hooks:install": "lefthook install"
	},
	"dependencies": {
		"@forgeax/design": "workspace:*",
		"@forgeax/chat": "workspace:*",
		"@radix-ui/react-dialog": "^1.1.2",
		"lucide-react": "^0.460.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^6.0.3",
		"typescript": "^5.6.3",
		"vite": "^8.0.0",
		"@biomejs/biome": "2.5.13",
		"lefthook": "2.1.14",
		"lint-staged": "16.4.0",
		"vite-plugin-checker": "0.14.5"
	},
	"lint-staged": {
		"*": "biome check --config-path=biome.json --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
